# Future application contract; no app currently loads these variables.
# Credentials belong to recipient-owned staging/production accounts. Never commit real values.
APP_URL=https://portal.example.invalid
AUTH_URL=https://portal.example.invalid
DATABASE_URL=postgresql://RUNTIME_USER:REPLACE_LOCALLY@DB_HOST/DATABASE?sslmode=require
DATABASE_MIGRATION_URL=postgresql://MIGRATION_USER:REPLACE_LOCALLY@DB_HOST/DATABASE?sslmode=require
AUTH_SECRET=REPLACE_LOCALLY
OIDC_PROVIDER_ID=REPLACE_LOCALLY
OIDC_ISSUER=https://identity.example.invalid
OIDC_CLIENT_ID=REPLACE_LOCALLY
OIDC_CLIENT_SECRET=REPLACE_LOCALLY
R2_ACCOUNT_ID=REPLACE_LOCALLY
R2_ENDPOINT=https://REPLACE_LOCALLY.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_LOCALLY
R2_SECRET_ACCESS_KEY=REPLACE_LOCALLY
R2_BUCKET=REPLACE_LOCALLY
RESEND_API_KEY=REPLACE_LOCALLY
RESEND_FROM=People <people@example.invalid>
RESEND_WEBHOOK_SECRET=REPLACE_LOCALLY
INNGEST_EVENT_KEY=REPLACE_LOCALLY
INNGEST_SIGNING_KEY=REPLACE_LOCALLY
ENABLE_ANONYMOUS_SURVEYS=false
