<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Setup operator review</title><link rel="stylesheet" href="/assets/intake.css"></head><body><main><h1>Setup operator review</h1><p><a href="/form">Back to form</a></p><p>Latest 100 active submissions. Download privately, then run scripts/prepare_setup.py from the reference checkout. Changing status does not activate services.</p><table><caption>Private setup submissions</caption><thead><tr><th>Receipt</th><th>Received</th><th>Expires</th><th>Status</th><th>Review</th></tr></thead><tbody>{% for row in rows %}<tr><td><a href="/api/submissions/{{ row.id }}/export">{{ row.id }}</a></td><td>{{ row.created_at }}</td><td>{{ row.expires_at }}</td><td>{{ row.status }}</td><td><form method="post" action="/api/submissions/{{ row.id }}/status"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Status <select name="status"><option value="received">Received</option><option value="reviewed">Reviewed</option><option value="closed">Closed</option></select></label><button type="submit">Save status</button></form></td></tr>{% else %}<tr><td colspan="5">No active submissions.</td></tr>{% endfor %}</tbody></table></main></body></html>
