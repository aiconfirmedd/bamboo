# Configure in the hosting provider's private environment, not in Git.
APP_ORIGIN=https://intake.example.com
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgresql://intake_runtime:REPLACE@YOUR_NEON_HOST/intake?sslmode=verify-full&sslrootcert=system
OIDC_ISSUER=https://YOUR_PROVIDER_ISSUER
OIDC_CLIENT_ID=REPLACE_WITH_INTAKE_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_INTAKE_CLIENT_SECRET
ALLOWED_EMAILS=setup-owner@example.com
OPERATOR_EMAILS=setup-operator@example.com
# Submission expiry from receipt, regardless of review status. HR retention is separate.
RETENTION_DAYS=30
